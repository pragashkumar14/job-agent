# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# France Travail — https://francetravail.io
# Create an account, declare an application, subscribe it to "Offres d'emploi v2"
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Optional
AGENT_MODEL=claude-sonnet-4-6
LOG_LEVEL=INFO

# Adzuna — https://developer.adzuna.com (instant, no approval)
# Use this if France Travail's Offres d'emploi API is not in your catalogue.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
